<Page x:Class="UP01_Chernenkaya_Book.Pages.ChangePasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Смена пароля">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="{DynamicResource SurfaceColor}"
                    BorderBrush="{DynamicResource BorderBrushColor}"
                    BorderThickness="1" CornerRadius="12"
                    MaxWidth="480" Margin="20,40" Padding="35"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Шаг 11: Смена пароля -->
                    <TextBlock Text="ИЗМЕНЕНИЕ ПАРОЛЯ" 
                               FontSize="20" FontWeight="Bold" 
                               Foreground="{DynamicResource TextColor}" 
                               HorizontalAlignment="Center" Margin="0,0,0,5" />

                    <TextBlock Text="Подтвердите текущие данные и задайте новый надежный пароль" 
                               FontSize="12" Foreground="{DynamicResource MutedTextColor}" 
                               HorizontalAlignment="Center" Margin="0,0,0,25" />

                    <!-- Логин -->
                    <TextBlock Text="Логин учетной записи:" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtLogin" Height="34" Margin="0,0,0,12"
                             ToolTip="Логин пользователя, для которого меняется пароль" />

                    <!-- Старый пароль -->
                    <TextBlock Text="Текущий (старый) пароль:" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PbOldPassword" Height="34" Margin="0,0,0,12"
                                 ToolTip="Введите действующий пароль" />

                    <!-- Новый пароль -->
                    <TextBlock Text="Новый пароль (от 6 символов, буквы и цифры):" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PbNewPassword" Height="34" Margin="0,0,0,12"
                                 ToolTip="Задайте новый надежный пароль" />

                    <!-- Повтор нового пароля -->
                    <TextBlock Text="Повторите новый пароль:" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PbNewPasswordConfirm" Height="34" Margin="0,0,0,20"
                                 ToolTip="Повторите новый пароль" />

                    <!-- Кнопки -->
                    <Button x:Name="BtnSubmitChangePassword" Content="Сохранить новый пароль" 
                            Height="40" Margin="0,0,0,10" 
                            Click="BtnSubmitChangePassword_Click" />

                    <Button Content="Отмена и возврат" 
                            Height="34" Margin="0,0,0,0"
                            Background="Transparent" Foreground="{DynamicResource MutedTextColor}"
                            BorderThickness="0"
                            Click="BtnBack_Click" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
