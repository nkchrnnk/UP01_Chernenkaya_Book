<Page x:Class="UP01_Chernenkaya_Book.Pages.UserCabinetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Chernenkaya_Book.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1000"
      Title="Личный кабинет гостя">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceColor}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="1" CornerRadius="8"
                Padding="15,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ЛИЧНЫЙ КАБИНЕТ ГОСТЯ" 
                               FontSize="18" FontWeight="Bold" 
                               Foreground="{DynamicResource PrimaryDarkColor}" />
                    <TextBlock x:Name="TxtUserProfile" Text="ФИО: ... | Телефон: ... | Email: ..." 
                               FontSize="12" Foreground="{DynamicResource TextColor}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Каталог отелей" Width="130" Height="34" Margin="0,0,10,0"
                            Background="{DynamicResource SurfaceColor}"
                            Foreground="{DynamicResource TextColor}"
                            BorderBrush="{DynamicResource BorderBrushColor}"
                            BorderThickness="1"
                            Click="BtnCatalog_Click" />

                    <Button Content="Сменить пароль" Width="130" Height="34"
                            Background="{DynamicResource SurfaceColor}"
                            Foreground="{DynamicResource TextColor}"
                            BorderBrush="{DynamicResource BorderBrushColor}"
                            BorderThickness="1"
                            Click="BtnChangePassword_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceColor}"
                    BorderBrush="{DynamicResource BorderBrushColor}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="Всего бронирований" FontSize="11" Foreground="{DynamicResource MutedTextColor}" />
                    <TextBlock x:Name="TxtTotalBookings" Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryDarkColor}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource SurfaceColor}"
                    BorderBrush="{DynamicResource BorderBrushColor}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="Ожидают оплаты" FontSize="11" Foreground="{DynamicResource MutedTextColor}" />
                    <TextBlock x:Name="TxtPendingPayment" Text="0" FontSize="20" FontWeight="Bold" Foreground="#D97706" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Background="{DynamicResource SurfaceColor}"
                    BorderBrush="{DynamicResource BorderBrushColor}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="Оплачено и подтверждено" FontSize="11" Foreground="{DynamicResource MutedTextColor}" />
                    <TextBlock x:Name="TxtConfirmedBookings" Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessColor}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceColor}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="1" CornerRadius="8"
                Padding="10">
            <DataGrid x:Name="DgUserBookings" AutoGenerateColumns="False" 
                      IsReadOnly="True" CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.CanContentScroll="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding BookingId}" Width="45" CanUserResize="False" />

                    <DataGridTemplateColumn Header="Объект размещения" Width="1.8*" MinWidth="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Room.Accommodation.Name}" FontWeight="Bold" Foreground="{DynamicResource TextColor}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Room.Accommodation.Name}" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextColor}" TextTrimming="CharacterEllipsis">
                                        <Run Text="📍 " />
                                        <Run Text="{Binding LocationText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Категория и номер" Width="1.2*" MinWidth="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Room.RoomType}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryDarkColor}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Room.RoomNumber, StringFormat='Номер №{0}'}" FontSize="11" Foreground="{DynamicResource MutedTextColor}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Период проживания" Width="1.1*" MinWidth="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding PeriodText, Mode=OneWay}" Foreground="{DynamicResource TextColor}" />
                                    <TextBlock Text="{Binding Guests, StringFormat='Гостей: {0} чел.'}" FontSize="11" Foreground="{DynamicResource MutedTextColor}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Статус заявки" Width="120" MinWidth="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BackgroundColor}" 
                                        BorderBrush="{DynamicResource BorderBrushColor}" 
                                        BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="4">
                                    <TextBlock Text="{Binding Status.StatusName, TargetNullValue='—'}" 
                                               FontWeight="SemiBold" FontSize="11" 
                                               HorizontalAlignment="Center" 
                                               Foreground="{DynamicResource PrimaryDarkColor}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Счет и оплата" Width="120" MinWidth="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalAmountText}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextColor}" />
                                    <TextBlock Text="{Binding PaymentStatusText}" FontSize="11" Foreground="{DynamicResource MutedTextColor}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Действия" Width="180" MinWidth="175">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,4" HorizontalAlignment="Center">
                                    <Button Content="💳 Оплатить" Height="28" Width="76" Margin="0,0,4,0"
                                            FontSize="10.5" IsEnabled="{Binding CanPay}"
                                            Click="BtnPayBooking_Click" />

                                    <Button Content="📄 Счет" Height="28" Width="52" Margin="0,0,4,0"
                                            FontSize="10.5"
                                            Background="{DynamicResource SurfaceColor}"
                                            Foreground="{DynamicResource TextColor}"
                                            BorderBrush="{DynamicResource BorderBrushColor}"
                                            BorderThickness="1"
                                            Click="BtnViewBill_Click" />

                                    <Button Content="✕" Height="28" Width="26"
                                            FontSize="11" Background="{DynamicResource DangerColor}"
                                            ToolTip="Отменить заявку на бронирование"
                                            IsEnabled="{Binding CanCancel}"
                                            Click="BtnCancelBooking_Click" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceColor}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="1" CornerRadius="6"
                Padding="12,8" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStatus" Text="Загрузка списка бронирований..." 
                       FontSize="12" Foreground="{DynamicResource TextColor}" FontWeight="SemiBold" />
        </Border>
    </Grid>
</Page>
