<Page x:Class="UP01_Chernenkaya_Book.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог объектов размещения">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Панель фильтров, поиска и сортировки (Шаг 8) -->
            <RowDefinition Height="Auto" />
            <!-- Область карточек объектов -->
            <RowDefinition Height="*" />
            <!-- Статусная строка -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель фильтрации и поиска -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceColor}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="1" CornerRadius="8"
                Padding="15,10" Margin="0,0,0,15">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Поиск -->
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="5,0" FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextColor}" />
                <TextBox x:Name="TxtSearch" Width="220" Height="32" Margin="5,0,15,0"
                         ToolTip="Поиск по названию отеля или адресу" 
                         TextChanged="FilterChanged" />

                <!-- Фильтр по городам -->
                <TextBlock Text="Город:" VerticalAlignment="Center" Margin="5,0" FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextColor}" />
                <ComboBox x:Name="CmbCity" Width="170" Height="32" Margin="5,0,15,0"
                          ToolTip="Фильтрация по городу расположения"
                          SelectionChanged="FilterChanged" />

                <!-- Фильтр по типу жилья -->
                <TextBlock Text="Тип:" VerticalAlignment="Center" Margin="5,0" FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextColor}" />
                <ComboBox x:Name="CmbType" Width="170" Height="32" Margin="5,0,15,0"
                          ToolTip="Фильтрация по типу объекта размещения"
                          SelectionChanged="FilterChanged" />

                <!-- Сортировка -->
                <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="5,0" FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextColor}" />
                <ComboBox x:Name="CmbSort" Width="180" Height="32" Margin="5,0,15,0"
                          ToolTip="Сортировка объектов"
                          SelectionChanged="FilterChanged">
                    <ComboBoxItem Content="По умолчанию" IsSelected="True" />
                    <ComboBoxItem Content="Сначала недорогие" />
                    <ComboBoxItem Content="Сначала дорогие" />
                    <ComboBoxItem Content="По рейтингу (высокий)" />
                </ComboBox>

                <!-- Сброс -->
                <Button x:Name="BtnReset" Content="Сбросить" 
                        Width="100" Height="32" Margin="5,0,15,0"
                        Background="{DynamicResource SurfaceColor}"
                        Foreground="{DynamicResource TextColor}"
                        BorderBrush="{DynamicResource BorderBrushColor}"
                        BorderThickness="1"
                        Click="BtnReset_Click" />

                <!-- Кнопка перехода в админку -->
                <Button x:Name="BtnAdminPanel" Content="★ Панель управления" 
                        Height="32" Margin="5,0,0,0"
                        Background="{DynamicResource PrimaryDarkColor}"
                        Foreground="#FFFFFF"
                        Visibility="Collapsed"
                        Click="BtnAdminPanel_Click" />
            </WrapPanel>
        </Border>

        <!-- Шаг 8: Область карточек (ListView с WrapPanel) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ListView x:Name="LvAccommodations" 
                      Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <!-- Карточка объекта размещения -->
                        <Border Width="340" Height="410" Margin="10"
                                Background="{DynamicResource SurfaceColor}"
                                BorderBrush="{DynamicResource BorderBrushColor}"
                                BorderThickness="1" CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Opacity="0.12" ShadowDepth="2" Direction="270" Color="#000000" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="180" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="50" />
                                </Grid.RowDefinitions>

                                <!-- Фотография отеля -->
                                <Border Grid.Row="0" CornerRadius="10,10,0,0" ClipToBounds="True">
                                    <Image Source="{Binding Photo, TargetNullValue='/res/default_hotel.png', FallbackValue='/res/default_hotel.png'}" 
                                           Stretch="UniformToFill" />
                                </Border>

                                <!-- Бейдж рейтинга на фото -->
                                <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" 
                                        Background="#CC111625" CornerRadius="6" Margin="10" Padding="8,4">
                                    <TextBlock Foreground="#FFD700" FontWeight="Bold" FontSize="13">
                                        <Run Text="★" />
                                        <Run Text="{Binding Rating, StringFormat=' {0:F1}'}" Foreground="#FFFFFF" />
                                    </TextBlock>
                                </Border>

                                <!-- Информация об объекте -->
                                <StackPanel Grid.Row="1" Margin="14,10">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" 
                                               Foreground="{DynamicResource TextColor}" TextTrimming="CharacterEllipsis" />

                                    <TextBlock Text="{Binding Type.TypeName}" FontSize="12" FontWeight="SemiBold" 
                                               Foreground="{DynamicResource PrimaryColor}" Margin="0,2,0,4" />

                                    <TextBlock Foreground="{DynamicResource MutedTextColor}" FontSize="12" Margin="0,0,0,4">
                                        <Run Text="📍 " />
                                        <Run Text="{Binding City.CityName}" FontWeight="SemiBold" />
                                        <Run Text=", " />
                                        <Run Text="{Binding Address}" />
                                    </TextBlock>

                                    <TextBlock Foreground="{DynamicResource TextColor}" FontSize="12" Margin="0,0,0,6">
                                        <Run Text="Номеров: " FontWeight="SemiBold" />
                                        <Run Text="{Binding Rooms}" />
                                        <Run Text=" | Вместимость: до " FontWeight="SemiBold" />
                                        <Run Text="{Binding Capacity}" />
                                        <Run Text=" гостей" />
                                    </TextBlock>

                                    <TextBlock Text="{Binding Description}" FontSize="11.5" 
                                               Foreground="{DynamicResource MutedTextColor}" 
                                               TextTrimming="CharacterEllipsis" MaxHeight="45" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Нижняя плашка с ценой и кнопкой -->
                                <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrushColor}" 
                                        BorderThickness="0,1,0,0" Padding="14,6" Background="#0A000000">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="от" FontSize="10" Foreground="{DynamicResource MutedTextColor}" />
                                            <TextBlock Foreground="{DynamicResource PrimaryDarkColor}" FontWeight="Bold" FontSize="16">
                                                <Run Text="{Binding PricePerNight, StringFormat='{}{0:N0}'}" />
                                                <Run Text=" ₽" FontSize="12" />
                                                <Run Text="/ ночь" FontSize="10" FontWeight="Normal" Foreground="{DynamicResource MutedTextColor}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="Забронировать" 
                                                Height="32" MinWidth="110" Margin="0" FontSize="11"
                                                Click="BtnBook_Click" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>

        <!-- Статусная строка: Найдено X из Y -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceColor}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="1" CornerRadius="6"
                Padding="12,8" Margin="0,10,0,0">
            <TextBlock x:Name="TxtCount" Text="Загрузка каталога..." 
                       Foreground="{DynamicResource TextColor}" FontWeight="SemiBold" FontSize="12" />
        </Border>
    </Grid>
</Page>
