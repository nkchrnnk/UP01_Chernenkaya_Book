<Page x:Class="UP01_Chernenkaya_Book.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация нового гостя">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="{DynamicResource SurfaceColor}"
                    BorderBrush="{DynamicResource BorderBrushColor}"
                    BorderThickness="1" CornerRadius="12"
                    MaxWidth="520" Margin="20,30" Padding="35"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                                        <TextBlock Text="РЕГИСТРАЦИЯ ГОСТЯ" 
                               FontSize="20" FontWeight="Bold" 
                               Foreground="{DynamicResource TextColor}" 
                               HorizontalAlignment="Center" Margin="0,0,0,5" />

                    <TextBlock Text="Заполните анкетные данные для создания личного кабинета" 
                               FontSize="12" Foreground="{DynamicResource MutedTextColor}" 
                               HorizontalAlignment="Center" Margin="0,0,0,20" />

                                        <TextBlock Text="ФИО (полностью):" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtFio" Height="34" Margin="0,0,0,12"
                             ToolTip="Введите вашу фамилию, имя и отчество" />

                                        <TextBlock Text="Логин:" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtLogin" Height="34" Margin="0,0,0,12"
                             ToolTip="Логин должен быть уникальным в системе" />

                                        <TextBlock Text="Электронная почта (Email):" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtEmail" Height="34" Margin="0,0,0,12"
                             ToolTip="Для подтверждения бронирований и чеков" />

                                        <TextBlock Text="Контактный телефон:" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtPhone" Height="34" Margin="0,0,0,12"
                             ToolTip="Формат: +7 (999) 000-00-00" />

                                        <TextBlock Text="Пароль (от 6 символов, буквы и цифры):" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PbPassword" Height="34" Margin="0,0,0,12"
                                 ToolTip="Пароль должен содержать минимум 6 символов, цифры и латинские буквы" />

                                        <TextBlock Text="Повторите пароль:" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PbPasswordConfirm" Height="34" Margin="0,0,0,20"
                                 ToolTip="Повторите введенный ранее пароль" />

                                        <Button x:Name="BtnSubmitRegister" Content="Зарегистрироваться" 
                            Height="40" Margin="0,0,0,10" 
                            Click="BtnSubmitRegister_Click" />

                    <Button Content="Уже есть аккаунт? Войти" 
                            Height="34" Margin="0,0,0,0"
                            Background="Transparent" Foreground="{DynamicResource PrimaryDarkColor}"
                            BorderThickness="0"
                            Click="BtnBackToLogin_Click" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
