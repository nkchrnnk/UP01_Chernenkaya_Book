<Page x:Class="UP01_Chernenkaya_Book.Pages.AddEditAccommodationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Редактирование объекта размещения">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="{DynamicResource SurfaceColor}"
                    BorderBrush="{DynamicResource BorderBrushColor}"
                    BorderThickness="1" CornerRadius="12"
                    MaxWidth="600" Margin="20,25" Padding="35"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Шаг 10: Форма добавления/редактирования -->
                    <TextBlock x:Name="TxtTitle" Text="ДОБАВЛЕНИЕ ОБЪЕКТА РАЗМЕЩЕНИЯ" 
                               FontSize="18" FontWeight="Bold" 
                               Foreground="{DynamicResource TextColor}" 
                               HorizontalAlignment="Center" Margin="0,0,0,5" />

                    <TextBlock Text="Заполните характеристики объекта гостиничной инфраструктуры" 
                               FontSize="12" Foreground="{DynamicResource MutedTextColor}" 
                               HorizontalAlignment="Center" Margin="0,0,0,20" />

                    <!-- Название -->
                    <TextBlock Text="Название объекта (отеля / апартаментов):" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtName" Height="34" Margin="0,0,0,10"
                             ToolTip="Полное коммерческое название отеля" />

                    <!-- Тип и Город -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="15" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Тип размещения:" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbType" Height="34"
                                      DisplayMemberPath="TypeName" SelectedValuePath="TypeId" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Город расположения:" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbCity" Height="34"
                                      DisplayMemberPath="CityName" SelectedValuePath="CityId" />
                        </StackPanel>
                    </Grid>

                    <!-- Адрес -->
                    <TextBlock Text="Фактический адрес:" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtAddress" Height="34" Margin="0,0,0,10"
                             ToolTip="Улица, дом, корпус" />

                    <!-- Число номеров, Вместимость, Цена, Рейтинг -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Номеров:" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtRooms" Height="34" ToolTip="Общее число номеров" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Мест:" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtCapacity" Height="34" ToolTip="Максимальная вместимость" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Цена (₽):" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtPrice" Height="34" ToolTip="Базовая цена за 1 ночь" />
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Рейтинг:" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtRating" Height="34" ToolTip="Оценка от 1.0 до 5.0" />
                        </StackPanel>
                    </Grid>

                    <!-- Описание -->
                    <TextBlock Text="Подробное описание:" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtDescription" Height="65" TextWrapping="Wrap" 
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"
                             ToolTip="Информация для гостей об услугах и преимуществах" />

                    <!-- Путь к фото -->
                    <TextBlock Text="Путь к фото или изображение:" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtPhoto" Height="34" Margin="0,0,0,20"
                             ToolTip="Относительный путь (например, /res/hotel1.png)" />

                    <!-- Кнопки -->
                    <Button x:Name="BtnSave" Content="Сохранить объект" 
                            Height="40" Margin="0,0,0,10" 
                            Click="BtnSave_Click" />

                    <Button Content="Отмена и назад" 
                            Height="34" Margin="0"
                            Background="Transparent" Foreground="{DynamicResource MutedTextColor}"
                            BorderThickness="0"
                            Click="BtnCancel_Click" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
