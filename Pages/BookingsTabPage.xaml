<Page x:Class="UP01_Chernenkaya_Book.Pages.BookingsTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Журнал бронирований">
    <Grid Margin="15">
        <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource SurfaceColor}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="1" CornerRadius="8"
                Padding="15,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" />
                    <TextBox x:Name="TxtSearch" Width="200" Height="32" Margin="0,0,15,0"
                             ToolTip="Поиск по ФИО гостя или отелю" 
                             TextChanged="FilterChanged" />

                    <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" />
                    <ComboBox x:Name="CmbStatusFilter" Width="180" Height="32" Margin="0,0,15,0"
                              ToolTip="Фильтрация по статусу бронирования"
                              SelectionChanged="FilterChanged" />
                </WrapPanel>

                <Button Grid.Column="1" Content="← В меню админа" 
                        Height="32" MinWidth="130"
                        Background="{DynamicResource SurfaceColor}"
                        Foreground="{DynamicResource TextColor}"
                        BorderBrush="{DynamicResource BorderBrushColor}"
                        BorderThickness="1"
                        Click="BtnBackToHub_Click" />
            </Grid>
        </Border>

                <DataGrid x:Name="DgBookings" Grid.Row="1"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" SelectionMode="Single"
                  Background="{DynamicResource SurfaceColor}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding BookingId}" Width="50" />
                <DataGridTextColumn Header="Гость (ФИО)" Binding="{Binding User.Fio}" Width="190" FontWeight="SemiBold" />
                <DataGridTextColumn Header="Телефон" Binding="{Binding User.Phone}" Width="125" />
                <DataGridTextColumn Header="Отель / Объект" Binding="{Binding Room.Accommodation.Name}" Width="*" MinWidth="170" />
                <DataGridTextColumn Header="Комната" Binding="{Binding Room.RoomNumber}" Width="75" />
                <DataGridTextColumn Header="Заезд" Binding="{Binding CheckIn, StringFormat='{}{0:dd.MM.yyyy}'}" Width="90" />
                <DataGridTextColumn Header="Выезд" Binding="{Binding CheckOut, StringFormat='{}{0:dd.MM.yyyy}'}" Width="90" />
                <DataGridTextColumn Header="Гостей" Binding="{Binding Guests}" Width="65" />
                
                                <DataGridTemplateColumn Header="Статус" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="6,3" HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1A3B82F6" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusId}" Value="1">
                                                <Setter Property="Background" Value="#2010B981" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusId}" Value="2">
                                                <Setter Property="Background" Value="#25F59E0B" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusId}" Value="4">
                                                <Setter Property="Background" Value="#20EF4444" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Status.StatusName}" FontWeight="SemiBold" FontSize="11.5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#2563EB" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusId}" Value="1">
                                                    <Setter Property="Foreground" Value="#10B981" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusId}" Value="2">
                                                    <Setter Property="Foreground" Value="#D97706" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusId}" Value="4">
                                                    <Setter Property="Foreground" Value="#EF4444" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Управление бронью" Width="285">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="✔ Подтвердить" Height="26" Width="105" MinWidth="90" Margin="2,0" Padding="2,0" FontSize="10.5"
                                        Background="#10B981" Foreground="#FFFFFF"
                                        Click="BtnConfirm_Click" ToolTip="Перевести статус в «Подтверждено»" />
                                <Button Content="✖ Отменить" Height="26" Width="85" MinWidth="75" Margin="2,0" Padding="2,0" FontSize="10.5"
                                        Background="#F59E0B" Foreground="#FFFFFF"
                                        Click="BtnCancelBooking_Click" ToolTip="Отменить бронирование" />
                                <Button Content="🗑 Удалить" Height="26" Width="80" MinWidth="70" Margin="2,0" Padding="2,0" FontSize="10.5"
                                        Background="{DynamicResource DangerColor}" Foreground="#FFFFFF"
                                        Click="BtnDeleteBooking_Click" ToolTip="Удалить запись из базы" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

                <Border Grid.Row="2" Background="{DynamicResource SurfaceColor}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="1" CornerRadius="6"
                Padding="12,8" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStatus" Text="Всего бронирований: 0" 
                       Foreground="{DynamicResource TextColor}" FontWeight="SemiBold" FontSize="12" />
        </Border>
    </Grid>
</Page>
