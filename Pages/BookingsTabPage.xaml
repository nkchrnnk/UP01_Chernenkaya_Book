<Page x:Class="UP01_Chernenkaya_Book.Pages.BookingsTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Журнал бронирований">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Панель фильтров -->
            <RowDefinition Height="Auto" />
            <!-- Таблица бронирований -->
            <RowDefinition Height="*" />
            <!-- Статусная строка -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceColor}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="1" CornerRadius="8"
                Padding="15,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" />
                    <TextBox x:Name="TxtSearch" Width="200" Height="32" Margin="0,0,15,0"
                             ToolTip="Поиск по ФИО гостя или отелю" 
                             TextChanged="FilterChanged" />

                    <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" />
                    <ComboBox x:Name="CmbStatusFilter" Width="180" Height="32" Margin="0,0,15,0"
                              ToolTip="Фильтрация по статусу бронирования"
                              SelectionChanged="FilterChanged" />
                </WrapPanel>

                <Button Grid.Column="1" Content="← В меню админа" 
                        Height="32" MinWidth="130"
                        Background="{DynamicResource SurfaceColor}"
                        Foreground="{DynamicResource TextColor}"
                        BorderBrush="{DynamicResource BorderBrushColor}"
                        BorderThickness="1"
                        Click="BtnBackToHub_Click" />
            </Grid>
        </Border>

        <!-- Таблица DataGrid бронирований -->
        <DataGrid x:Name="DgBookings" Grid.Row="1"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" SelectionMode="Single"
                  Background="{DynamicResource SurfaceColor}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding BookingId}" Width="50" />
                <DataGridTextColumn Header="Гость (ФИО)" Binding="{Binding User.Fio}" Width="200" FontWeight="SemiBold" />
                <DataGridTextColumn Header="Телефон" Binding="{Binding User.Phone}" Width="130" />
                <DataGridTextColumn Header="Отель / Объект" Binding="{Binding Room.Accommodation.Name}" Width="210" />
                <DataGridTextColumn Header="Комната" Binding="{Binding Room.RoomNumber}" Width="75" />
                <DataGridTextColumn Header="Заезд" Binding="{Binding CheckIn, StringFormat='{}{0:dd.MM.yyyy}'}" Width="95" />
                <DataGridTextColumn Header="Выезд" Binding="{Binding CheckOut, StringFormat='{}{0:dd.MM.yyyy}'}" Width="95" />
                <DataGridTextColumn Header="Гостей" Binding="{Binding Guests}" Width="65" />
                <DataGridTextColumn Header="Статус" Binding="{Binding Status.StatusName}" Width="130" FontWeight="SemiBold" />

                <!-- Быстрые действия со статусом брони -->
                <DataGridTemplateColumn Header="Управление статусом" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="✔ Подтвердить" Height="26" MinWidth="85" Margin="2,0" FontSize="10.5"
                                        Background="#2A9D8F"
                                        Click="BtnConfirm_Click" />
                                <Button Content="✖ Отменить" Height="26" MinWidth="75" Margin="2,0" FontSize="10.5"
                                        Background="{DynamicResource DangerColor}"
                                        Click="BtnCancelBooking_Click" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Статусная строка -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceColor}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="1" CornerRadius="6"
                Padding="12,8" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStatus" Text="Всего бронирований: 0" 
                       Foreground="{DynamicResource TextColor}" FontWeight="SemiBold" FontSize="12" />
        </Border>
    </Grid>
</Page>
