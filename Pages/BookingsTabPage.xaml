<Page x:Class="UP01_Chernenkaya_Book.Pages.BookingsTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Chernenkaya_Book.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1000"
      Title="Журнал бронирований">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceColor}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="1" CornerRadius="8"
                Padding="15,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" />
                    <TextBox x:Name="TxtSearch" Width="200" Height="32" Margin="0,0,15,0"
                             ToolTip="Поиск по ФИО гостя или отелю" 
                             TextChanged="FilterChanged" />

                    <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" />
                    <ComboBox x:Name="CmbStatusFilter" Width="180" Height="32" Margin="0,0,15,0"
                              ToolTip="Фильтрация по статусу бронирования"
                              SelectionChanged="FilterChanged" />
                </WrapPanel>

                <Button Grid.Column="1" Content="← В меню админа" 
                        Height="32" MinWidth="130"
                        Background="{DynamicResource SurfaceColor}"
                        Foreground="{DynamicResource TextColor}"
                        BorderBrush="{DynamicResource BorderBrushColor}"
                        BorderThickness="1"
                        Click="BtnBackToHub_Click" />
            </Grid>
        </Border>

        <DataGrid x:Name="DgBookings" Grid.Row="1"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserResizeColumns="True"
                  IsReadOnly="True" SelectionMode="Single"
                  Background="{DynamicResource SurfaceColor}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding BookingId}" Width="50" CanUserResize="False" />
                <DataGridTextColumn Header="Гость (ФИО)" Binding="{Binding User.Fio}" Width="190" MinWidth="130" FontWeight="SemiBold">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding User.Fio}" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Телефон" Binding="{Binding User.Phone}" Width="135" MinWidth="110" />
                <DataGridTextColumn Header="Отель / Объект" Binding="{Binding Room.Accommodation.Name}" Width="*" MinWidth="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding Room.Accommodation.Name}" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Категория" Binding="{Binding Room.RoomType}" Width="120" MinWidth="90" />
                <DataGridTextColumn Header="Номер" Binding="{Binding Room.RoomNumber}" Width="65" MinWidth="50" />
                <DataGridTextColumn Header="Заезд" Binding="{Binding CheckIn, StringFormat='{}{0:dd.MM.yyyy}'}" Width="85" MinWidth="75" />
                <DataGridTextColumn Header="Выезд" Binding="{Binding CheckOut, StringFormat='{}{0:dd.MM.yyyy}'}" Width="85" MinWidth="75" />
                <DataGridTextColumn Header="Гостей" Binding="{Binding Guests}" Width="60" MinWidth="50" />

                <DataGridTemplateColumn Header="Статус заявки" Width="135">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="6,3" HorizontalAlignment="Center"
                                    Background="{DynamicResource BackgroundColor}"
                                    BorderBrush="{DynamicResource BorderBrushColor}"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding Status.StatusName}" FontWeight="SemiBold" FontSize="11.5"
                                           Foreground="{DynamicResource PrimaryDarkColor}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Управление бронью" Width="310">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Одобрить счет" Height="26" Width="95" Margin="2,0" Padding="2,0" FontSize="10.5"
                                        Background="{DynamicResource PrimaryColor}" Foreground="#FFFFFF"
                                        Click="BtnApprove_Click" ToolTip="Одобрить заявку и перевести в статус «Ожидает оплаты»" />

                                <Button Content="✔ Подтвердить" Height="26" Width="95" Margin="2,0" Padding="2,0" FontSize="10.5"
                                        Background="#10B981" Foreground="#FFFFFF"
                                        Click="BtnConfirm_Click" ToolTip="Перевести статус в «Подтверждено»" />

                                <Button Content="✖ Отмена" Height="26" Width="65" Margin="2,0" Padding="2,0" FontSize="10.5"
                                        Background="#F59E0B" Foreground="#FFFFFF"
                                        Click="BtnCancelBooking_Click" ToolTip="Отменить бронирование" />

                                <Button Content="🗑" Height="26" Width="30" Margin="2,0" Padding="2,0" FontSize="10.5"
                                        Background="{DynamicResource DangerColor}" Foreground="#FFFFFF"
                                        Click="BtnDeleteBooking_Click" ToolTip="Удалить запись из базы" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceColor}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="1" CornerRadius="6"
                Padding="12,8" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStatus" Text="Всего бронирований: 0" 
                       Foreground="{DynamicResource TextColor}" FontWeight="SemiBold" FontSize="12" />
        </Border>
    </Grid>
</Page>
