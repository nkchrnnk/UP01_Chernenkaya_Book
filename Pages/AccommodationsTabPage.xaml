<Page x:Class="UP01_Chernenkaya_Book.Pages.AccommodationsTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление объектами размещения">
    <Grid Margin="15">
        <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource SurfaceColor}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="1" CornerRadius="8"
                Padding="15,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" />
                    <TextBox x:Name="TxtSearch" Width="260" Height="32" Margin="0,0,15,0"
                             ToolTip="Поиск по названию или адресу" 
                             TextChanged="TxtSearch_TextChanged" />

                    <Button x:Name="BtnAdd" Content="+ Добавить объект" 
                            Height="32" MinWidth="150" Margin="0,0,10,0"
                            Click="BtnAdd_Click" />
                </StackPanel>

                <Button Grid.Column="1" Content="← В меню админа" 
                        Height="32" MinWidth="130"
                        Background="{DynamicResource SurfaceColor}"
                        Foreground="{DynamicResource TextColor}"
                        BorderBrush="{DynamicResource BorderBrushColor}"
                        BorderThickness="1"
                        Click="BtnBackToHub_Click" />
            </Grid>
        </Border>

                <DataGrid x:Name="DgAccommodations" Grid.Row="1"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" SelectionMode="Single"
                  Background="{DynamicResource SurfaceColor}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding AccommodationId}" Width="50" />
                <DataGridTextColumn Header="Название объекта" Binding="{Binding Name}" Width="220" />
                <DataGridTextColumn Header="Тип" Binding="{Binding Type.TypeName}" Width="130" />
                <DataGridTextColumn Header="Город" Binding="{Binding City.CityName}" Width="120" />
                <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="230" />
                <DataGridTextColumn Header="Номеров" Binding="{Binding Rooms}" Width="80" />
                <DataGridTextColumn Header="Мест" Binding="{Binding Capacity}" Width="70" />
                <DataGridTextColumn Header="Цена/ночь" Binding="{Binding PricePerNight, StringFormat='{}{0:N0} ₽'}" Width="100" />
                <DataGridTextColumn Header="Рейтинг" Binding="{Binding Rating, StringFormat='⭐ {0:F1}'}" Width="85" />

                                <DataGridTemplateColumn Header="Действия" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Изменить" Height="26" MinWidth="75" Margin="2,0" FontSize="11"
                                        Click="BtnEdit_Click" />
                                <Button Content="Удалить" Height="26" MinWidth="70" Margin="2,0" FontSize="11"
                                        Background="{DynamicResource DangerColor}"
                                        Click="BtnDelete_Click" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

                <Border Grid.Row="2" Background="{DynamicResource SurfaceColor}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="1" CornerRadius="6"
                Padding="12,8" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStatus" Text="Всего объектов в базе: 0" 
                       Foreground="{DynamicResource TextColor}" FontWeight="SemiBold" FontSize="12" />
        </Border>
    </Grid>
</Page>
