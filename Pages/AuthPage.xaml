<Page x:Class="UP01_Chernenkaya_Book.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="{DynamicResource SurfaceColor}"
                    BorderBrush="{DynamicResource BorderBrushColor}"
                    BorderThickness="1" CornerRadius="12"
                    MaxWidth="450" Margin="20,40" Padding="35"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Заголовок формы (Шаг 4) -->
                    <TextBlock Text="ВХОД В СИСТЕМУ" 
                               FontSize="20" FontWeight="Bold" 
                               Foreground="{DynamicResource TextColor}" 
                               HorizontalAlignment="Center" Margin="0,0,0,5" />

                    <TextBlock Text="Сервис бронирования гостиниц и апартаментов" 
                               FontSize="12" Foreground="{DynamicResource MutedTextColor}" 
                               HorizontalAlignment="Center" Margin="0,0,0,25" />

                    <!-- Логин -->
                    <TextBlock Text="Логин пользователя:" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,5" />
                    <TextBox x:Name="TxtLogin" Height="36" Margin="0,0,0,15"
                             ToolTip="Введите ваш уникальный логин в системе" />

                    <!-- Пароль -->
                    <TextBlock Text="Пароль:" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,5" />
                    <PasswordBox x:Name="PbPassword" Height="36" Margin="0,0,0,20"
                                 ToolTip="Введите пароль от вашей учетной записи" />

                    <!-- Шаг 5: Блок капчи (появляется при 3 неверных попытках) -->
                    <StackPanel x:Name="CaptchaPanel" Visibility="Collapsed" Margin="0,0,0,20">
                        <TextBlock Text="Защитный код подтверждения (Капча):" 
                                   FontWeight="SemiBold" Foreground="{DynamicResource DangerColor}" Margin="0,0,0,5" />

                        <Border Background="{DynamicResource BackgroundColor}" BorderBrush="{DynamicResource PrimaryColor}" 
                                BorderThickness="1" CornerRadius="6" Height="45" Margin="0,0,0,10">
                            <Grid>
                                <!-- Фоновые линии шума капчи -->
                                <Line X1="10" Y1="10" X2="280" Y2="35" Stroke="{DynamicResource BorderBrushColor}" StrokeThickness="2" />
                                <Line X1="30" Y1="38" X2="290" Y2="12" Stroke="{DynamicResource PrimaryColor}" Opacity="0.6" StrokeThickness="1.5" />
                                <TextBlock x:Name="TxtCaptchaCode" 
                                           Text="A7X9" FontSize="24" FontWeight="Bold" 
                                           FontStyle="Italic" Foreground="{DynamicResource PrimaryDarkColor}" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TextBox x:Name="TxtCaptchaInput" Height="36"
                                 ToolTip="Введите символы с картинки выше (копирование запрещено)" />
                    </StackPanel>

                    <!-- Кнопки действий -->
                    <Button x:Name="BtnSignIn" Content="Войти в систему" 
                            Height="40" Margin="0,0,0,10" 
                            Click="BtnSignIn_Click" />

                    <Button x:Name="BtnGuest" Content="Продолжить как гость" 
                            Height="36" Margin="0,0,0,10" 
                            Background="{DynamicResource SurfaceColor}"
                            Foreground="{DynamicResource TextColor}"
                            BorderBrush="{DynamicResource BorderBrushColor}"
                            BorderThickness="1"
                            Click="BtnGuest_Click" />

                    <Separator Margin="0,10,0,15" Background="{DynamicResource BorderBrushColor}" />

                    <!-- Дополнительные ссылки: Регистрация и Смена пароля -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Регистрация" 
                                Width="130" Height="32" Margin="5,0"
                                Background="Transparent" Foreground="{DynamicResource PrimaryDarkColor}"
                                BorderThickness="0"
                                Click="BtnRegister_Click" />

                        <Button Content="Смена пароля" 
                                Width="130" Height="32" Margin="5,0"
                                Background="Transparent" Foreground="{DynamicResource MutedTextColor}"
                                BorderThickness="0"
                                Click="BtnChangePassword_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
