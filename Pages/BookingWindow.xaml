<Window x:Class="UP01_Chernenkaya_Book.Pages.BookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP01_Chernenkaya_Book.Pages"
        mc:Ignorable="d"
        Title="Оформление заявки на бронирование" 
        Height="700" Width="660"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundColor}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceColor}"
                BorderBrush="{DynamicResource BorderBrushColor}"
                BorderThickness="1" CornerRadius="8"
                Padding="15,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="TxtHotelName" Text="Название отеля" 
                           FontWeight="Bold" FontSize="18" 
                           Foreground="{DynamicResource PrimaryDarkColor}" />
                <TextBlock x:Name="TxtHotelAddress" Text="Город, адрес" 
                           FontSize="12" Foreground="{DynamicResource MutedTextColor}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="{DynamicResource SurfaceColor}"
                    BorderBrush="{DynamicResource BorderBrushColor}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="18,15">
                <StackPanel>
                    <TextBlock Text="Категория номера:" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                    <ComboBox x:Name="CmbRooms" Height="36" Margin="0,0,0,12"
                              SelectionChanged="CmbRooms_SelectionChanged" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="15" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Дата заезда:" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                            <DatePicker x:Name="DpCheckIn" Height="34" 
                                        SelectedDateChanged="Dates_SelectedDateChanged" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Дата выезда:" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                            <DatePicker x:Name="DpCheckOut" Height="34" 
                                        SelectedDateChanged="Dates_SelectedDateChanged" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="TxtNightsCount" Text="Продолжительность: 3 суток" 
                               FontSize="12" FontWeight="SemiBold" 
                               Foreground="{DynamicResource PrimaryColor}" Margin="0,0,0,12" />

                    <TextBlock Text="Количество человек (гостей):" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                    <ComboBox x:Name="CmbGuests" Height="34" Margin="0,0,0,12">
                        <ComboBoxItem Content="1 гость" />
                        <ComboBoxItem Content="2 гостя" IsSelected="True" />
                        <ComboBoxItem Content="3 гостя" />
                        <ComboBoxItem Content="4 гостя" />
                        <ComboBoxItem Content="5 гостей" />
                    </ComboBox>

                    <TextBlock Text="Дополнительные услуги:" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                    <Border BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" 
                            CornerRadius="6" Padding="8" Margin="0,0,0,12" Background="{DynamicResource BackgroundColor}">
                        <StackPanel x:Name="PanelServices" />
                    </Border>

                    <TextBlock Text="Пожелания к бронированию:" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtComment" Height="50" TextWrapping="Wrap" 
                             AcceptsReturn="True" Margin="0,0,0,14" 
                             ToolTip="Укажите особые пожелания к номеру (тихий номер, этаж, детская кроватка и т.д.)" />

                    <Border Background="{DynamicResource BackgroundColor}" 
                            BorderBrush="{DynamicResource BorderBrushColor}" 
                            BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Предварительный расчет стоимости:" 
                                       FontWeight="Bold" Foreground="{DynamicResource TextColor}" Margin="0,0,0,4" />
                            <TextBlock x:Name="TxtCostRoom" Text="Проживание: 0 ₽" FontSize="12" Foreground="{DynamicResource MutedTextColor}" />
                            <TextBlock x:Name="TxtCostServices" Text="Услуги: 0 ₽" FontSize="12" Foreground="{DynamicResource MutedTextColor}" />
                            <Separator Margin="0,6" Background="{DynamicResource BorderBrushColor}" />
                            <TextBlock x:Name="TxtTotalCost" Text="ИТОГО К ОПЛАТЕ: 0 ₽" 
                                       FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryDarkColor}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ⓘ После подачи заявки администратор проверит её и переведет в статус «Ожидает оплаты». Оплата производится в Личном кабинете." 
                               TextWrapping="Wrap" FontSize="11" FontStyle="Italic" 
                               Foreground="{DynamicResource MutedTextColor}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="Отмена" 
                        Width="110" Height="36" Margin="0,0,10,0"
                        Background="{DynamicResource SurfaceColor}"
                        Foreground="{DynamicResource TextColor}"
                        BorderBrush="{DynamicResource BorderBrushColor}"
                        BorderThickness="1"
                        Click="BtnCancel_Click" />

                <Button Grid.Column="2" Content="Отправить заявку" 
                        Width="160" Height="36"
                        Click="BtnSubmit_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
